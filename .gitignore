# Build output - everything here is regenerated by ./build.sh
deploy/

# Vivado project - regenerated from scratch by vivado/scripts/01_create_project.tcl
# (create_project ... -force), so none of it is source.
vivado/pdp2011_zynq/
.Xil/
.vivado_compat/

# Vivado batch-run logs/journals left next to the scripts on every run
vivado/scripts/*.log
vivado/scripts/*.jou
vivado/scripts/*.backup.log

# Disk images - large binaries, either downloadable (see README) or local
# test fixtures; don't belong in git history.
disks/*.img

# pdp11-hostd host-side build products. The PetaLinux recipe builds these in
# the Yocto work dir; a standalone `make` in files/ (handy for testing the
# web panel on a desktop) leaves them next to the sources.
petalinux/meta-user/recipes-apps/pdp11-hostd/files/pdp11-hostd
petalinux/meta-user/recipes-apps/pdp11-hostd/files/libhttpd.a
petalinux/meta-user/recipes-apps/pdp11-hostd/files/httpd.o
petalinux/meta-user/recipes-apps/pdp11-hostd/files/www_data.h
