#!/bin/sh
### BEGIN INIT INFO
# Provides:          pdp11-netd
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PDP-11 Ethernet bridge (xu DEUNA ring <-> tap0 <-> br0/eth0)
### END INIT INFO

DAEMON=/usr/bin/pdp11-netd
LOG=/var/log/pdp11-netd.log

case "$1" in
  start)
    if ps 2>/dev/null | grep -q '[u]sr/bin/pdp11-netd'; then
      echo "pdp11-netd already running - not starting a second"
      exit 0
    fi
    echo "Starting pdp11-netd"
    nohup "$DAEMON" -l "$LOG" -i tap0 >/dev/null 2>&1 &
    ;;
  stop)
    echo "Stopping pdp11-netd"
    for p in $(ps | grep '[u]sr/bin/pdp11-netd' | awk '{print $1}'); do kill "$p"; done
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
