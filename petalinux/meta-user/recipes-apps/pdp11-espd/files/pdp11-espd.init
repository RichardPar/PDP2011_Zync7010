#!/bin/sh
### BEGIN INIT INFO
# Provides:          pdp11-espd
# Required-Start:    $local_fs pdp11-diskd
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PDP-11 XU network bridge ("virtual ESP32" over AXI)
### END INIT INFO

DAEMON=/usr/bin/pdp11-espd
LOG=/var/log/pdp11-espd.log

case "$1" in
  start)
    # match the running DAEMON by its binary path, not this init script
    # (whose own argv contains "pdp11-espd" too)
    if ps 2>/dev/null | grep -q '[u]sr/bin/pdp11-espd'; then
      echo "pdp11-espd already running - not starting a second"
      exit 0
    fi
    echo "Starting pdp11-espd"
    nohup "$DAEMON" -l "$LOG" >/dev/null 2>&1 &
    ;;
  stop)
    echo "Stopping pdp11-espd"
    for p in $(ps | grep '[u]sr/bin/pdp11-espd' | awk '{print $1}'); do kill "$p"; done
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
